#!/usr/bin/env bash
# .githooks/pre-commit — privacy guard for the citizenlab-claude overlay and
# the private LLM skills.
#
# Activated by setting `git config core.hooksPath .githooks` (done by
# bin/setup-claude and bin/setup-llm-skills).
# Bypassable with `git commit --no-verify` only when truly intentional.

set -e

STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"

# 1. Block any path under .claude/ from being staged. Everything there is
#    private (mirrored from citizenlab-claude) and materialized at runtime
#    by bin/setup-claude.
PRIVATE_PATHS="$(echo "$STAGED" | grep -E '^\.claude/' || true)"
if [ -n "$PRIVATE_PATHS" ]; then
  echo "ERROR: refusing to commit private Claude overlay paths:" >&2
  echo "$PRIVATE_PATHS" | sed 's/^/  /' >&2
  echo "These must remain gitignored. Bypass with --no-verify only if you really mean it." >&2
  exit 1
fi

# 2. Block any CLAUDE.md from being staged. They're all gitignored file
#    symlinks materialized by bin/setup-claude — no CLAUDE.md should ever
#    be committed. Edits to CLAUDE.md content belong in citizenlab-claude.
CLAUDE_CHANGES="$(echo "$STAGED" | grep -E '(^|/)CLAUDE\.md$' || true)"
if [ -n "$CLAUDE_CHANGES" ]; then
  echo "ERROR: refusing to commit a CLAUDE.md file:" >&2
  echo "$CLAUDE_CHANGES" | sed 's/^/  /' >&2
  echo "All CLAUDE.md files are gitignored symlinks managed by bin/setup-claude;" >&2
  echo "edit content in the citizenlab-claude private overlay instead." >&2
  echo "Bypass with --no-verify only if you really mean it." >&2
  exit 1
fi

# 3. Block the root .mcp.json from being staged. It's a gitignored symlink
#    into the private overlay (team-shared MCP config) materialized by
#    bin/setup-claude — committing it would leak overlay content.
MCP_CHANGES="$(echo "$STAGED" | grep -E '^\.mcp\.json$' || true)"
if [ -n "$MCP_CHANGES" ]; then
  echo "ERROR: refusing to commit .mcp.json:" >&2
  echo "$MCP_CHANGES" | sed 's/^/  /' >&2
  echo "The root .mcp.json is a gitignored symlink managed by bin/setup-claude;" >&2
  echo "edit the MCP config in the citizenlab-claude private overlay instead." >&2
  echo "Bypass with --no-verify only if you really mean it." >&2
  exit 1
fi

# 4. Block the LLM skills link (back/vendor/llm_skills) and anything under
#    that path. It's a gitignored symlink to a private repo, made by
#    bin/setup-llm-skills; a copy put in its place would leak that repo.
LLM_SKILLS_CHANGES="$(echo "$STAGED" | grep -E '^back/vendor/llm_skills(/|$)' || true)"
if [ -n "$LLM_SKILLS_CHANGES" ]; then
  echo "ERROR: refusing to commit the private LLM skills:" >&2
  echo "$LLM_SKILLS_CHANGES" | sed 's/^/  /' >&2
  echo "back/vendor/llm_skills is a gitignored symlink managed by bin/setup-llm-skills." >&2
  echo "Bypass with --no-verify only if you really mean it." >&2
  exit 1
fi

# 5. Chain to existing .git/hooks/pre-commit (e.g. husky's prettier check) so we don't disable it.
if [ -x .git/hooks/pre-commit ]; then
  exec .git/hooks/pre-commit "$@"
fi

exit 0
