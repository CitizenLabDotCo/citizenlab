<%
  shaded = local_assigns[:variant].to_s == 'shaded'
  surface = shaded ? 'background-color:#F2F6F8;' : 'border:1px solid #eaeaea; background-color:#fff;'
%>
<mj-section padding="<%= local_assigns[:padding] || '0 25px 25px' %>">
  <mj-column>
    <mj-table>
      <tr>
        <td style="<%= surface %> padding:20px 25px; border-radius:5px;">
          <h2 style="font-size: 18px; margin-top: 10px; margin-bottom: 10px;">
            <%= local_assigns[:title] %>
          </h2>
          <% if local_assigns[:details].present? %>
            <p style="margin: 0; color: #84939E; font-size: 14px;">
              <%= local_assigns[:details] %>
            </p>
          <% end %>
          <% if local_assigns[:description].present? %>
            <p style="margin-top: 10px; color: #84939E;">
              <%= local_assigns[:description] %>
            </p>
          <% end %>
        </td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
