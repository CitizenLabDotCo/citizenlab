<% if localize_for_recipient(event.project_description_multiloc).present? %>
  <%= render partial: 'email_campaigns/application/card', locals: {
    title: localize_for_recipient(event.project_title_multiloc),
    description: localize_for_recipient(event.project_description_multiloc)
  } %>
<% end %>

<%= render partial: 'application/cta_button', locals: {
  href: event.admin_project_url ,
  message: cta_button_text
} %>
