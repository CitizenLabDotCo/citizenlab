{
  "description": "List answers: `contains_any`, `contains_all`.",
  "cases": [
    {
      "description": "contains_any matches one shared option",
      "program": {
        "pages": [
          {
            "id": "p1",
            "fields": ["q"],
            "jumps": [{"when": {"field": "q", "op": "contains_any", "value": ["a", "b"]}, "goto": "p3"}]
          },
          {"id": "p2"},
          {"id": "p3"}
        ]
      },
      "answers": {"q": ["c", "b"]},
      "expected": {
        "path": ["p1", "p3"],
        "visible_ids": ["q"],
        "required_ids": [],
        "answers": {"q": ["c", "b"]}
      }
    },
    {
      "description": "contains_any does not match without shared options",
      "program": {
        "pages": [
          {
            "id": "p1",
            "fields": ["q"],
            "jumps": [{"when": {"field": "q", "op": "contains_any", "value": ["a", "b"]}, "goto": "p3"}]
          },
          {"id": "p2"},
          {"id": "p3"}
        ]
      },
      "answers": {"q": ["c"]},
      "expected": {
        "path": ["p1", "p2", "p3"],
        "visible_ids": ["q"],
        "required_ids": [],
        "answers": {"q": ["c"]}
      }
    },
    {
      "description": "contains_any does not match an empty answer",
      "program": {
        "pages": [
          {
            "id": "p1",
            "fields": ["q"],
            "jumps": [{"when": {"field": "q", "op": "contains_any", "value": ["a"]}, "goto": "p3"}]
          },
          {"id": "p2"},
          {"id": "p3"}
        ]
      },
      "answers": {"q": []},
      "expected": {"path": ["p1", "p2", "p3"], "visible_ids": ["q"], "required_ids": [], "answers": {"q": []}}
    },
    {
      "description": "contains_any does not match a missing answer",
      "program": {
        "pages": [
          {
            "id": "p1",
            "fields": ["q"],
            "jumps": [{"when": {"field": "q", "op": "contains_any", "value": ["a"]}, "goto": "p3"}]
          },
          {"id": "p2"},
          {"id": "p3"}
        ]
      },
      "answers": {},
      "expected": {"path": ["p1", "p2", "p3"], "visible_ids": ["q"], "required_ids": [], "answers": {}}
    },
    {
      "description": "contains_any never matches a single value",
      "program": {
        "pages": [
          {
            "id": "p1",
            "fields": ["q"],
            "jumps": [{"when": {"field": "q", "op": "contains_any", "value": ["a"]}, "goto": "p3"}]
          },
          {"id": "p2"},
          {"id": "p3"}
        ]
      },
      "answers": {"q": "a"},
      "expected": {
        "path": ["p1", "p2", "p3"],
        "visible_ids": ["q"],
        "required_ids": [],
        "answers": {"q": "a"}
      }
    },
    {
      "description": "contains_any with an empty list never matches",
      "program": {
        "pages": [
          {
            "id": "p1",
            "fields": ["q"],
            "jumps": [{"when": {"field": "q", "op": "contains_any", "value": []}, "goto": "p3"}]
          },
          {"id": "p2"},
          {"id": "p3"}
        ]
      },
      "answers": {"q": ["a"]},
      "expected": {
        "path": ["p1", "p2", "p3"],
        "visible_ids": ["q"],
        "required_ids": [],
        "answers": {"q": ["a"]}
      }
    },
    {
      "description": "contains_any treats 1 and 1.0 as equal",
      "program": {
        "pages": [
          {
            "id": "p1",
            "fields": ["q"],
            "jumps": [{"when": {"field": "q", "op": "contains_any", "value": [1]}, "goto": "p3"}]
