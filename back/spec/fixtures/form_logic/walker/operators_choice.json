          },
          {"id": "p2"},
          {"id": "p3"}
        ]
      },
      "answers": {"q": "red"},
      "expected": {"path": ["p1", "p3"], "visible_ids": ["q"], "required_ids": [], "answers": {"q": "red"}}
    },
