{
  "description": "AND/OR/NOT groups.",
  "cases": [
    {
      "description": "all: every part holds",
      "program": {
        "pages": [
          {
            "id": "p1",
            "fields": ["a", "b"],
            "jumps": [
              {
                "when": {
                  "all": [{"field": "a", "op": "eq", "value": "yes"}, {"field": "b", "op": "gt", "value": 5}]
                },
                "goto": "p3"
              }
            ]
          },
          {"id": "p2"},
          {"id": "p3"}
        ]
      },
      "answers": {"a": "yes", "b": 6},
      "expected": {
        "path": ["p1", "p3"],
        "visible_ids": ["a", "b"],
        "required_ids": [],
        "answers": {"a": "yes", "b": 6}
      }
    },
    {
      "description": "all: one part fails",
