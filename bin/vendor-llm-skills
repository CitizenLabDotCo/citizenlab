#!/usr/bin/env bash
# bin/vendor-llm-skills — copy the skills listed in back/config/llm_skills.yml,
# at the commit it pins, from the private skills repo into <out_dir>: each
# skill's .md files and its plugin's shared ones, as AIAssistant::Skill reads
# them. CI runs it into back/vendor/llm_skills before building the back image.
# It prints skill names only, never their text, as CI logs may be public.
#
# Needs yq and LLM_SKILLS_GIT_REMOTE (the skills repo's remote, kept out of this repo).
#
# Usage: bin/vendor-llm-skills <out_dir>

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The test points this at its own manifest.
MANIFEST="${LLM_SKILLS_MANIFEST:-$SCRIPT_DIR/../back/config/llm_skills.yml}"

if [ $# -ne 1 ]; then
  echo "Usage: bin/vendor-llm-skills <out_dir>" >&2
  exit 1
fi
OUT_DIR="$1"

if [ -z "${LLM_SKILLS_GIT_REMOTE:-}" ]; then
  echo "Error: LLM_SKILLS_GIT_REMOTE is not set." >&2
  exit 1
fi
if ! command -v yq >/dev/null; then
  echo "Error: yq is not installed." >&2
  exit 1
fi
# Never replaces what is there, e.g. the link bin/setup-llm-skills makes in development.
if [ -e "$OUT_DIR" ] || [ -L "$OUT_DIR" ]; then
  echo "Error: $OUT_DIR already exists." >&2
  exit 1
fi

ref="$(yq -r '.ref' "$MANIFEST")"
skills="$(yq -r '.skills[]' "$MANIFEST")"

# The skills are copied to $work/out and moved to <out_dir> only once all of them are
# there, so a failed run leaves nothing behind.
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
repo="$work/repo"
out="$work/out"
mkdir -p "$out"

echo "Fetching the LLM skills at $ref ..."
git init -q "$repo"
git -C "$repo" fetch -q --depth 1 "$LLM_SKILLS_GIT_REMOTE" "$ref"
git -C "$repo" checkout -q FETCH_HEAD

for skill in $skills; do
  skill_dirs=("$repo"/plugins/*/skills/"$skill")
  if [ ! -d "${skill_dirs[0]}" ]; then
    echo "Error: there is no skill $skill at $ref." >&2
    exit 1
  fi
  skill_path="${skill_dirs[0]#"$repo/"}"
  plugin_path="${skill_path%/skills/*}"

  sources=("$skill_path")
  if [ -d "$repo/$plugin_path/shared" ]; then
    sources+=("$plugin_path/shared")
  fi

  while IFS= read -r file; do
    mkdir -p "$out/$(dirname "$file")"
    cp "$repo/$file" "$out/$file"
  done < <(cd "$repo" && find "${sources[@]}" -type f -name '*.md')

  echo "  $skill"
done

mkdir -p "$(dirname "$OUT_DIR")"
mv "$out" "$OUT_DIR"
echo "Copied the LLM skills into $OUT_DIR."
